              "W",
              "Z"
            ]
          },
          "minItems": 1,
          "title": "Routes",
          "type": "array"
        },
        "overrides": {
          "items": {
            "$ref": "#/$defs/OverrideGroup"
          },
          "title": "Overrides",
          "type": "array"
        }
      },
      "required": [
        "name",
        "routes"
      ],
      "title": "ScenarioEntry",
      "type": "object"
    }
  },
