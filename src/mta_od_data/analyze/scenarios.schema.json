    "ScenarioEntry": {
      "additionalProperties": false,
      "description": "One scenario in a scenario file, under its category's key rather\nthan carrying a `category` field. `description` defaults to `name`.\n\n`routes` is the universe this scenario is about (e.g. A,B,C,D for a\nColumbus Circle swap): which routes count towards a one-seat ride,\nand which origins are worth classifying. It belongs to the scenario\nrather than the invocation -- a Columbus swap is about the same four\nroutes whoever runs it -- and must cover every route the scenario\nmoves (`Scenario.load`). A run classifies everything it selects under\nthe union of these; see `ScenarioRun`.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "routes": {
          "items": {
            "type": "string",
            "enum": [
              "1",
              "2",
              "3",
              "4",
              "5",
              "6",
              "7",
              "A",
