// Named lines for `mta-od-data ridership --by line`:
// a path rides a line if one of its rides goes between two stops
// one after the other in one of the line's lists (GTFS parent stop IDs), either way,
// whatever its route.
//
// A trunk with express tracks lists its stops in order on each:
// `local` (every station the local tracks pass),
// and `express` (the stations express trains stop at),
// and is three lines: the trunk, `<trunk> local`, and `<trunk> express`.
// A hop in both, between express stations with no station between,
// is on the express tracks on `express_routes`' trains and on the local tracks on others'.
// `tracks` are a trunk's other stops in order, with no express tracks,
// counted only as the trunk.
// A list in `tracks` can be `{routes, stops}`: track only `routes`' trains ride,
// where another line's stations, on another level, share its stop IDs.
// A short list joins a trunk to the next one where their trains cross over,
// so a ride through the junction is on the trunk.
{
  // IRT

  "Broadway-7 Av": {
    tracks: [
      // Van Cortlandt Park-242 St to 103 St.
      ["101", "103", "104", "106", "107", "108", "109", "110", "111", "112", "113", "114", "115", "116", "117", "118", "119", "120"],
      // Chambers St to South Ferry, and the 2 and 3's Clark St tunnel's
      // Park Place, Fulton St, and Wall St.
      ["137", "138", "139", "142"],
      ["137", "228", "229", "230"],
    ],
    // 96 St to Chambers St.
    local: [["120", "121", "122", "123", "124", "125", "126", "127", "128", "129", "130", "131", "132", "133", "134", "135", "136", "137"]],
    express: [["120", "123", "127", "128", "132", "137"]],
    express_routes: ["2", "3"],
  },
  "Lenox Av": {
    tracks: [
      // Harlem-148 St to 96 St, and the 2 and 5 from the Bronx.
      ["301", "302", "224", "225", "226", "227", "120"],
      ["222", "224"],
    ],
  },
  "Lexington Av": {
    tracks: [
      // Brooklyn Bridge-City Hall to Borough Hall, and the 4 and 5 from the Bronx,
      // some 4s in rush hours from 149 St-Grand Concourse.
      ["640", "418", "419", "420", "423"],
      ["416", "621"],
      ["415", "621"],
    ],
    // 125 St to Brooklyn Bridge-City Hall.
    local: [["621", "622", "623", "624", "625", "626", "627", "628", "629", "630", "631", "632", "633", "634", "635", "636", "637", "638", "639", "640"]],
    express: [["621", "626", "629", "631", "635", "640"]],
    express_routes: ["4", "5"],
  },
