// Generalized cost weights for splitting each OD row's riders
// across its Pareto-optimal journeys (`mta-od-data raptor assign`; see `raptor_design.md`).
// Neutral to start: every second of a journey costs the same,
// so riders split by travel time alone, until there's a basis for anything else.
{
  // Minutes of perceived cost per minute waiting on a platform,
  // at the origin or between trains.
  wait_weight: 1.0,
  // Per minute walking between platforms,
  // or changing trains at one stop (its `transfers.txt` minimum change time).
  walk_weight: 1.0,
  // Minutes added per transfer, on top of its walk and wait.
  // 0 to start: a cross-platform transfer costs nothing,
  // and one to an express can even be preferred,
  // so a flat penalty is the wrong shape anyway (see `raptor_design.md`).
  transfer_penalty_min: 0.0,
  // Logit scale per minute of cost:
  // a journey costing 1/scale more minutes gets 1/e of the riders.
  // A placeholder: no neutral value exists, and this one has no source.
  logit_scale_per_min: 0.2,
  // Where transfer times come from, where `pathways.txt` doesn't have them:
  // a feed's pathways always come first, their quickest walks between the stops they reach,
  // free across one platform.
  // Elsewhere, "osm", by OSM's platforms: changing trains on one platform is free,
  // changing to another of a station's platforms is up a flight of stairs,
  // across between the stops at `speeds`' walk, and down a flight,
  // (`platforms.csv`),
  // and a complex's stops without a `transfers.txt` footpath are
  // 60s plus their straight-line distance apart at `speeds`' walk;
  // or "gtfs", `transfers.txt` at its word,
  // whose flat 180s to change trains even across a platform is the less real.
  transfers: "osm",
  // Where pathways are, minutes added per walk out through the fare gates and back in,
  // on top of its walk.
  // A placeholder, like `logit_scale_per_min`: no source gives one.
  fare_gate_penalty_min: 10.0,
  // Walking speeds inside stations, in miles an hour:
  // on the level, and up and down stairs and escalators along their slopes.
  // Guesses: 3 mph on the level, as on the street
  // (Anita's model's 1.2 m/s, 2.7 mph, allowed for stairs on the way);
  // an escalator moves at 1.1 mph, and some riders walk on it.
  // Crowding would slow them, but isn't modeled yet.
  // Where nothing measures it, a flight of stairs is a level, 3.3 m, at 30 degrees,
  // the median LiDAR maps measure:
  // OSM transfers' up and over, and between platforms stacked one right over another
  // (`stacked_platforms.csv`), a flight a level, up or down by OSM's levels,
  // and passages' levels, which way unknown.
  speeds: {
    walk_mph: 3.0,
    stairs_up_mph: 1.1,
    stairs_down_mph: 1.6,
    escalator_up_mph: 1.3,
    escalator_down_mph: 1.6,
  },
  // Most rides in a journey: riders take up to 4-ride trips,
  // and one more allows the rare fastest trip that takes 5.
  max_rides: 5,
}
